# Copy to /etc/omnireborn.env on the Vultr server and chmod 640.
CHAIN_ID=4663
# Robinhood uses Etherscan-compatible credentials. Arc uses ArcScan public API.
ROBIN_ETHERSCAN_API_KEY=
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
ARC_EXPLORER_API_URL=https://api.arc-scan.org/api

# Production must use private/archive-capable providers for every enabled chain.
# The preflight rejects the official public endpoints.
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_ME
ARC_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/REPLACE_ME
# BSC public RPC endpoints are not sufficient for dependable historical logs.
# Configure a private/archive-capable BSC endpoint before enabling chain 56.
BSC_RPC_URL=https://bsc-mainnet.g.alchemy.com/v2/REPLACE_ME
ENABLED_CHAIN_IDS=4663,5042
BASE_RPC_URL=https://mainnet.base.org
ETH_RPC_URL=https://cloudflare-eth.com
ROBINHOOD_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
# Robinhood migration gate: quote assets are excluded; a candidate also needs a
# DexScreener base-token pair created close to the Initialize event.
RBH_QUOTE_ASSET_ADDRESSES=0x0bd7d308f8e1639fab988df18a8011f41eacad73
RBH_PAIR_TIME_TOLERANCE_SECONDS=600
RBH_DEX_INDEX_GRACE_SECONDS=600
# Phase 1 intake defaults to Telegram-forwarded notices. Set hybrid only when
# you intentionally want the DexScreener/RPC discovery scans enabled as well.
DISCOVERY_MODE=forwarded_only
FORWARDED_RBH_LOOKBACK_BLOCKS=5000
FORWARDED_INTAKE_GRACE_SECONDS=900
# Granular source switches (override DISCOVERY_MODE or toggle live via /sources in Telegram):
# SOURCE_PONS_FORWARD=true
# SOURCE_ARC_FORWARD=true
# SOURCE_BSC_FORWARD=false
# BSC graduation is allowed only for an authentic forwarded Flap migration from
# these source channel IDs. Do not use a public group ID or leave this blank.
BSC_TRUSTED_FORWARD_CHANNEL_IDS=-1003634653232
# SOURCE_RBH_RPC_SCAN=false
# SOURCE_DEXSCREENER_SCAN=false

FORENSICS_DB_PATH=/opt/omnireborn/data/forensics.db
RUNTIME_DIR=/opt/omnireborn/runtime
REPORT_OUTPUT_PATH=/opt/omnireborn/runtime/phase1_fingerprint_report.json
DASHBOARD_DATA_DIR=/opt/omnireborn/runtime
DASHBOARD_OUTPUT_DIR=/opt/omnireborn/runtime/site-build
DASHBOARD_API_URL=
API_SNAPSHOT_PATH=/opt/omnireborn/runtime/dashboard_candidates.json
API_ALLOWED_ORIGINS=
API_ALLOWED_HOSTS=localhost,127.0.0.1
API_MAX_SNAPSHOT_AGE_SECONDS=3600
BACKUP_DIR=/var/backups/omnireborn

# Phase 1: ten-minute evidence collection. Telegram is read/on-demand only.
COLLECTION_INTERVAL_SECONDS=600
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_TOP_LEADS=5
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_PUSH_ALERTS=false
TELEGRAM_ALERT_THRESHOLD=65
TELEGRAM_ALERT_EXISTING_ON_START=false
TELEGRAM_DASHBOARD_PATH=/opt/omnireborn/runtime/site-build/index.html
TELEGRAM_HEALTH_MAX_AGE_SECONDS=180
