[Unit]
Description=OmniReborn crash-safe Robinhood Chain collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=omnireborn
Group=omnireborn
SupplementaryGroups=www-data
WorkingDirectory=/opt/omnireborn
EnvironmentFile=/etc/omnireborn.env
ExecStartPre=/opt/omnireborn/.venv/bin/python /opt/omnireborn/streamer.py --preflight
ExecStart=/opt/omnireborn/.venv/bin/python /opt/omnireborn/streamer.py --stream --interval 60 --max-jobs 5
ExecStopPost=/opt/omnireborn/.venv/bin/python /opt/omnireborn/backup_database.py --retention-days 14
Restart=always
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/omnireborn /var/www/omnireborn /var/backups/omnireborn
UMask=0027

[Install]
WantedBy=multi-user.target
