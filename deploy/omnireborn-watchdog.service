[Unit]
Description=Check OmniReborn heartbeat and restart a stale worker
After=omnireborn.service

[Service]
Type=oneshot
EnvironmentFile=/etc/omnireborn.env
ExecStart=/bin/bash -c '/opt/omnireborn/.venv/bin/python /opt/omnireborn/streamer.py --health-check --interval "${COLLECTION_INTERVAL_SECONDS:-600}" || /bin/systemctl restart omnireborn.service'
