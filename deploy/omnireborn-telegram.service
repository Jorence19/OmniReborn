[Unit]
Description=OmniReborn private Telegram delivery bot
Wants=network-online.target
After=network-online.target omnireborn.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=omnireborn
Group=omnireborn
WorkingDirectory=/opt/omnireborn
EnvironmentFile=/etc/omnireborn.env
ExecStartPre=/opt/omnireborn/.venv/bin/python /opt/omnireborn/telegram_bot.py --check
ExecStart=/opt/omnireborn/.venv/bin/python /opt/omnireborn/telegram_bot.py
Restart=always
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/omnireborn/data /opt/omnireborn/runtime
UMask=0027

[Install]
WantedBy=multi-user.target
